{
 "cells": [
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "# Proyek Klasifikasi Gambar - Klasifikasi Buah-Buahan\n",
    "\n",
    "**Nama:** [Nama Anda]\n",
    "\n",
    "**Email:** [Email Anda]\n",
    "\n",
    "**ID Dicoding:** [ID Dicoding Anda]\n",
    "\n",
    "---\n",
    "\n",
    "## Deskripsi Proyek\n",
    "Proyek ini bertujuan untuk mengklasifikasikan gambar buah-buahan (Apel, Pisang, Jeruk) menggunakan Convolutional Neural Network (CNN)."
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 1. Import Library"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import tensorflow as tf\n",
    "from tensorflow.keras.models import Sequential\n",
    "from tensorflow.keras.layers import Conv2D, MaxPooling2D, Flatten, Dense, Dropout\n",
    "from tensorflow.keras.preprocessing.image import ImageDataGenerator\n",
    "from tensorflow.keras.callbacks import EarlyStopping, ModelCheckpoint, ReduceLROnPlateau\n",
    "import matplotlib.pyplot as plt\n",
    "import numpy as np\n",
    "import os\n",
    "import shutil\n",
    "import zipfile\n",
    "from sklearn.model_selection import train_test_split\n",
    "from PIL import Image\n",
    "import json\n",
    "\n",
    "print(f\"TensorFlow Version: {tf.__version__}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 2. Download dan Persiapan Dataset\n",
    "\n",
    "**Catatan:** Ganti bagian ini dengan kode scraping dataset Anda sendiri.\n",
    "Contoh ini menggunakan dataset buah-buahan."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Jika menggunakan Google Colab, mount Google Drive\n",
    "# from google.colab import drive\n",
    "# drive.mount('/content/drive')\n",
    "\n",
    "# Definisikan path dataset\n",
    "DATASET_DIR = '/content/dataset'\n",
    "TRAIN_DIR = os.path.join(DATASET_DIR, 'train')\n",
    "VAL_DIR = os.path.join(DATASET_DIR, 'validation')\n",
    "TEST_DIR = os.path.join(DATASET_DIR, 'test')"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 3. Data Scraping (WAJIB - Ganti dengan kode scraping Anda)\n",
    "\n",
    "**PENTING:** Anda HARUS melakukan scraping data sendiri. Berikut contoh struktur kode scraping:"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# =====================================================\n",
    "# CONTOH KODE SCRAPING - GANTI DENGAN IMPLEMENTASI ANDA\n",
    "# =====================================================\n",
    "\n",
    "\"\"\"\n",
    "Contoh scraping dari Google Images menggunakan icrawler:\n",
    "\n",
    "!pip install icrawler\n",
    "\n",
    "from icrawler.builtin import GoogleImageCrawler\n",
    "\n",
    "def scrape_images(keyword, num_images, save_dir):\n",
    "    crawler = GoogleImageCrawler(storage={'root_dir': save_dir})\n",
    "    crawler.crawl(keyword=keyword, max_num=num_images)\n",
    "\n",
    "# Scraping untuk setiap kelas\n",
    "classes = ['apple fruit', 'banana fruit', 'orange fruit']\n",
    "for cls in classes:\n",
    "    save_path = f'/content/raw_data/{cls.split()[0]}'\n",
    "    scrape_images(cls, 4000, save_path)\n",
    "    print(f\"Selesai scraping {cls}\")\n",
    "\"\"\"\n",
    "\n",
    "# Contoh scraping dari Bing Images:\n",
    "\"\"\"\n",
    "from icrawler.builtin import BingImageCrawler\n",
    "\n",
    "def scrape_bing_images(keyword, num_images, save_dir):\n",
    "    crawler = BingImageCrawler(storage={'root_dir': save_dir})\n",
    "    crawler.crawl(keyword=keyword, max_num=num_images)\n",
    "\n",
    "classes = ['apple fruit fresh', 'banana fruit fresh', 'orange fruit fresh']\n",
    "for cls in classes:\n",
    "    class_name = cls.split()[0]\n",
    "    save_path = f'/content/raw_data/{class_name}'\n",
    "    os.makedirs(save_path, exist_ok=True)\n",
    "    scrape_bing_images(cls, 4000, save_path)\n",
    "    print(f\"Selesai scraping {cls}: {len(os.listdir(save_path))} gambar\")\n",
    "\"\"\"\n",
    "\n",
    "print(\"PENTING: Implementasikan kode scraping Anda di sini!\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 4. Pembagian Dataset (Train, Validation, Test)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def create_directory_structure(base_dir, classes):\n",
    "    \"\"\"Membuat struktur direktori untuk train, val, test\"\"\"\n",
    "    for split in ['train', 'validation', 'test']:\n",
    "        for cls in classes:\n",
    "            path = os.path.join(base_dir, split, cls)\n",
    "            os.makedirs(path, exist_ok=True)\n",
    "            print(f\"Created: {path}\")\n",
    "\n",
    "def split_dataset(source_dir, dest_dir, classes, train_ratio=0.7, val_ratio=0.15, test_ratio=0.15):\n",
    "    \"\"\"Membagi dataset menjadi train, validation, dan test set\"\"\"\n",
    "    \n",
    "    for cls in classes:\n",
    "        source_class_dir = os.path.join(source_dir, cls)\n",
    "        \n",
    "        if not os.path.exists(source_class_dir):\n",
    "            print(f\"Warning: {source_class_dir} tidak ditemukan\")\n",
    "            continue\n",
    "            \n",
    "        # Ambil semua file gambar\n",
    "        images = [f for f in os.listdir(source_class_dir) \n",
    "                  if f.lower().endswith(('.png', '.jpg', '.jpeg', '.bmp', '.gif'))]\n",
    "        \n",
    "        print(f\"Kelas {cls}: {len(images)} gambar\")\n",
    "        \n",
    "        # Split data\n",
    "        train_imgs, temp_imgs = train_test_split(images, train_size=train_ratio, random_state=42)\n",
    "        val_imgs, test_imgs = train_test_split(temp_imgs, train_size=val_ratio/(val_ratio+test_ratio), random_state=42)\n",
    "        \n",
    "        # Copy files\n",
    "        for img in train_imgs:\n",
    "            src = os.path.join(source_class_dir, img)\n",
    "            dst = os.path.join(dest_dir, 'train', cls, img)\n",
    "            shutil.copy2(src, dst)\n",
    "            \n",
    "        for img in val_imgs:\n",
    "            src = os.path.join(source_class_dir, img)\n",
    "            dst = os.path.join(dest_dir, 'validation', cls, img)\n",
    "            shutil.copy2(src, dst)\n",
    "            \n",
    "        for img in test_imgs:\n",
    "            src = os.path.join(source_class_dir, img)\n",
    "            dst = os.path.join(dest_dir, 'test', cls, img)\n",
    "            shutil.copy2(src, dst)\n",
    "        \n",
    "        print(f\"  Train: {len(train_imgs)}, Val: {len(val_imgs)}, Test: {len(test_imgs)}\")\n",
    "\n",
    "# Definisikan kelas-kelas Anda (minimal 3 kelas untuk nilai tinggi)\n",
    "CLASSES = ['apple', 'banana', 'orange']\n",
    "\n",
    "# Buat struktur direktori\n",
    "create_directory_structure(DATASET_DIR, CLASSES)\n",
    "\n",
    "# Split dataset (uncomment setelah scraping selesai)\n",
    "# RAW_DATA_DIR = '/content/raw_data'\n",
    "# split_dataset(RAW_DATA_DIR, DATASET_DIR, CLASSES)"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 5. Menghitung Jumlah Data"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def count_images(directory):\n",
    "    \"\"\"Menghitung jumlah gambar dalam direktori\"\"\"\n",
    "    total = 0\n",
    "    if os.path.exists(directory):\n",
    "        for cls in os.listdir(directory):\n",
    "            class_dir = os.path.join(directory, cls)\n",
    "            if os.path.isdir(class_dir):\n",
    "                count = len([f for f in os.listdir(class_dir) \n",
    "                           if f.lower().endswith(('.png', '.jpg', '.jpeg', '.bmp', '.gif'))])\n",
    "                print(f\"  {cls}: {count} gambar\")\n",
    "                total += count\n",
    "    return total\n",
    "\n",
    "print(\"=\" * 50)\n",
    "print(\"STATISTIK DATASET\")\n",
    "print(\"=\" * 50)\n",
    "\n",
    "print(\"\\nTraining Set:\")\n",
    "train_count = count_images(TRAIN_DIR)\n",
    "print(f\"Total: {train_count} gambar\\n\")\n",
    "\n",
    "print(\"Validation Set:\")\n",
    "val_count = count_images(VAL_DIR)\n",
    "print(f\"Total: {val_count} gambar\\n\")\n",
    "\n",
    "print(\"Test Set:\")\n",
    "test_count = count_images(TEST_DIR)\n",
    "print(f\"Total: {test_count} gambar\\n\")\n",
    "\n",
    "print(\"=\" * 50)\n",
    "print(f\"TOTAL SEMUA DATASET: {train_count + val_count + test_count} gambar\")\n",
    "print(\"=\" * 50)"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 6. Data Preprocessing dan Augmentation"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Parameter\n",
    "IMG_HEIGHT = 150\n",
    "IMG_WIDTH = 150\n",
    "BATCH_SIZE = 32\n",
    "\n",
    "# ImageDataGenerator untuk Training (dengan augmentation)\n",
    "train_datagen = ImageDataGenerator(\n",
    "    rescale=1./255,\n",
    "    rotation_range=40,\n",
    "    width_shift_range=0.2,\n",
    "    height_shift_range=0.2,\n",
    "    shear_range=0.2,\n",
    "    zoom_range=0.2,\n",
    "    horizontal_flip=True,\n",
    "    fill_mode='nearest'\n",
    ")\n",
    "\n",
    "# ImageDataGenerator untuk Validation dan Test (tanpa augmentation)\n",
    "val_test_datagen = ImageDataGenerator(rescale=1./255)\n",
    "\n",
    "# Generator untuk Training\n",
    "train_generator = train_datagen.flow_from_directory(\n",
    "    TRAIN_DIR,\n",
    "    target_size=(IMG_HEIGHT, IMG_WIDTH),\n",
    "    batch_size=BATCH_SIZE,\n",
    "    class_mode='categorical',\n",
    "    shuffle=True\n",
    ")\n",
    "\n",
    "# Generator untuk Validation\n",
    "validation_generator = val_test_datagen.flow_from_directory(\n",
    "    VAL_DIR,\n",
    "    target_size=(IMG_HEIGHT, IMG_WIDTH),\n",
    "    batch_size=BATCH_SIZE,\n",
    "    class_mode='categorical',\n",
    "    shuffle=False\n",
    ")\n",
    "\n",
    "# Generator untuk Test\n",
    "test_generator = val_test_datagen.flow_from_directory(\n",
    "    TEST_DIR,\n",
    "    target_size=(IMG_HEIGHT, IMG_WIDTH),\n",
    "    batch_size=BATCH_SIZE,\n",
    "    class_mode='categorical',\n",
    "    shuffle=False\n",
    ")\n",
    "\n",
    "# Simpan class indices\n",
    "class_indices = train_generator.class_indices\n",
    "print(\"\\nClass Indices:\", class_indices)\n",
    "\n",
    "# Buat label mapping\n",
    "labels = list(class_indices.keys())\n",
    "print(\"Labels:\", labels)"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 7. Visualisasi Sample Data"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def visualize_samples(generator, title=\"Sample Images\"):\n",
    "    \"\"\"Menampilkan sample gambar dari generator\"\"\"\n",
    "    plt.figure(figsize=(15, 10))\n",
    "    images, labels_batch = next(generator)\n",
    "    \n",
    "    # Dapatkan nama kelas\n",
    "    class_names = list(generator.class_indices.keys())\n",
    "    \n",
    "    for i in range(min(12, len(images))):\n",
    "        plt.subplot(3, 4, i + 1)\n",
    "        plt.imshow(images[i])\n",
    "        label_idx = np.argmax(labels_batch[i])\n",
    "        plt.title(class_names[label_idx])\n",
    "        plt.axis('off')\n",
    "    \n",
    "    plt.suptitle(title, fontsize=16)\n",
    "    plt.tight_layout()\n",
    "    plt.show()\n",
    "\n",
    "# Visualisasi sample training data\n",
    "visualize_samples(train_generator, \"Sample Training Images (dengan Augmentation)\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 8. Membangun Model CNN (Sequential dengan Conv2D dan Pooling)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Jumlah kelas\n",
    "NUM_CLASSES = len(class_indices)\n",
    "print(f\"Jumlah Kelas: {NUM_CLASSES}\")\n",
    "\n",
    "# Membangun model Sequential dengan Conv2D dan MaxPooling\n",
    "model = Sequential([\n",
    "    # Block 1\n",
    "    Conv2D(32, (3, 3), activation='relu', input_shape=(IMG_HEIGHT, IMG_WIDTH, 3)),\n",
    "    MaxPooling2D(pool_size=(2, 2)),\n",
    "    \n",
    "    # Block 2\n",
    "    Conv2D(64, (3, 3), activation='relu'),\n",
    "    MaxPooling2D(pool_size=(2, 2)),\n",
    "    \n",
    "    # Block 3\n",
    "    Conv2D(128, (3, 3), activation='relu'),\n",
    "    MaxPooling2D(pool_size=(2, 2)),\n",
    "    \n",
    "    # Block 4\n",
    "    Conv2D(128, (3, 3), activation='relu'),\n",
    "    MaxPooling2D(pool_size=(2, 2)),\n",
    "    \n",
    "    # Flatten dan Dense layers\n",
    "    Flatten(),\n",
    "    Dropout(0.5),\n",
    "    Dense(512, activation='relu'),\n",
    "    Dropout(0.3),\n",
    "    Dense(NUM_CLASSES, activation='softmax')\n",
    "])\n",
    "\n",
    "# Compile model\n",
    "model.compile(\n",
    "    optimizer='adam',\n",
    "    loss='categorical_crossentropy',\n",
    "    metrics=['accuracy']\n",
    ")\n",
    "\n",
    "# Summary model\n",
    "model.summary()"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 9. Implementasi Callbacks"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Callback 1: Early Stopping - menghentikan training jika tidak ada improvement\n",
    "early_stopping = EarlyStopping(\n",
    "    monitor='val_loss',\n",
    "    patience=10,\n",
    "    restore_best_weights=True,\n",
    "    verbose=1\n",
    ")\n",
    "\n",
    "# Callback 2: Model Checkpoint - menyimpan model terbaik\n",
    "checkpoint = ModelCheckpoint(\n",
    "    'best_model.keras',\n",
    "    monitor='val_accuracy',\n",
    "    save_best_only=True,\n",
    "    mode='max',\n",
    "    verbose=1\n",
    ")\n",
    "\n",
    "# Callback 3: Reduce LR on Plateau - mengurangi learning rate jika stuck\n",
    "reduce_lr = ReduceLROnPlateau(\n",
    "    monitor='val_loss',\n",
    "    factor=0.2,\n",
    "    patience=5,\n",
    "    min_lr=1e-7,\n",
    "    verbose=1\n",
    ")\n",
    "\n",
    "callbacks = [early_stopping, checkpoint, reduce_lr]"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 10. Training Model"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "EPOCHS = 50\n",
    "\n",
    "# Training\n",
    "history = model.fit(\n",
    "    train_generator,\n",
    "    steps_per_epoch=train_generator.samples // BATCH_SIZE,\n",
    "    epochs=EPOCHS,\n",
    "    validation_data=validation_generator,\n",
    "    validation_steps=validation_generator.samples // BATCH_SIZE,\n",
    "    callbacks=callbacks,\n",
    "    verbose=1\n",
    ")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 11. Plot Akurasi dan Loss"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def plot_training_history(history):\n",
    "    \"\"\"Plot akurasi dan loss dari training history\"\"\"\n",
    "    fig, axes = plt.subplots(1, 2, figsize=(14, 5))\n",
    "    \n",
    "    # Plot Accuracy\n",
    "    axes[0].plot(history.history['accuracy'], label='Training Accuracy', linewidth=2)\n",
    "    axes[0].plot(history.history['val_accuracy'], label='Validation Accuracy', linewidth=2)\n",
    "    axes[0].set_title('Model Accuracy', fontsize=14)\n",
    "    axes[0].set_xlabel('Epoch')\n",
    "    axes[0].set_ylabel('Accuracy')\n",
    "    axes[0].legend(loc='lower right')\n",
    "    axes[0].grid(True, alpha=0.3)\n",
    "    \n",
    "    # Plot Loss\n",
    "    axes[1].plot(history.history['loss'], label='Training Loss', linewidth=2)\n",
    "    axes[1].plot(history.history['val_loss'], label='Validation Loss', linewidth=2)\n",
    "    axes[1].set_title('Model Loss', fontsize=14)\n",
    "    axes[1].set_xlabel('Epoch')\n",
    "    axes[1].set_ylabel('Loss')\n",
    "    axes[1].legend(loc='upper right')\n",
    "    axes[1].grid(True, alpha=0.3)\n",
    "    \n",
    "    plt.tight_layout()\n",
    "    plt.savefig('training_history.png', dpi=150, bbox_inches='tight')\n",
    "    plt.show()\n",
    "    \n",
    "    print(\"\\nPlot disimpan sebagai 'training_history.png'\")\n",
    "\n",
    "plot_training_history(history)"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 12. Evaluasi Model"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Evaluasi pada Training Set\n",
    "print(\"=\" * 50)\n",
    "print(\"EVALUASI MODEL\")\n",
    "print(\"=\" * 50)\n",
    "\n",
    "# Reset generator\n",
    "train_generator.reset()\n",
    "train_loss, train_accuracy = model.evaluate(train_generator, verbose=0)\n",
    "print(f\"\\nTraining Set:\")\n",
    "print(f\"  Loss: {train_loss:.4f}\")\n",
    "print(f\"  Accuracy: {train_accuracy:.4f} ({train_accuracy*100:.2f}%)\")\n",
    "\n",
    "# Evaluasi pada Validation Set\n",
    "validation_generator.reset()\n",
    "val_loss, val_accuracy = model.evaluate(validation_generator, verbose=0)\n",
    "print(f\"\\nValidation Set:\")\n",
    "print(f\"  Loss: {val_loss:.4f}\")\n",
    "print(f\"  Accuracy: {val_accuracy:.4f} ({val_accuracy*100:.2f}%)\")\n",
    "\n",
    "# Evaluasi pada Test Set\n",
    "test_generator.reset()\n",
    "test_loss, test_accuracy = model.evaluate(test_generator, verbose=0)\n",
    "print(f\"\\nTest Set:\")\n",
    "print(f\"  Loss: {test_loss:.4f}\")\n",
    "print(f\"  Accuracy: {test_accuracy:.4f} ({test_accuracy*100:.2f}%)\")\n",
    "\n",
    "print(\"\\n\" + \"=\" * 50)\n",
    "if train_accuracy >= 0.85 and test_accuracy >= 0.85:\n",
    "    print(\"✅ KRITERIA TERPENUHI: Akurasi >= 85%\")\n",
    "else:\n",
    "    print(\"❌ KRITERIA BELUM TERPENUHI: Akurasi < 85%\")\n",
    "print(\"=\" * 50)"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 13. Confusion Matrix dan Classification Report"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "from sklearn.metrics import confusion_matrix, classification_report\n",
    "import seaborn as sns\n",
    "\n",
    "# Prediksi pada test set\n",
    "test_generator.reset()\n",
    "predictions = model.predict(test_generator, verbose=1)\n",
    "predicted_classes = np.argmax(predictions, axis=1)\n",
    "\n",
    "# True labels\n",
    "true_classes = test_generator.classes\n",
    "class_labels = list(test_generator.class_indices.keys())\n",
    "\n",
    "# Confusion Matrix\n",
    "cm = confusion_matrix(true_classes, predicted_classes)\n",
    "\n",
    "plt.figure(figsize=(10, 8))\n",
    "sns.heatmap(cm, annot=True, fmt='d', cmap='Blues', \n",
    "            xticklabels=class_labels, yticklabels=class_labels)\n",
    "plt.title('Confusion Matrix', fontsize=14)\n",
    "plt.xlabel('Predicted Label')\n",
    "plt.ylabel('True Label')\n",
    "plt.tight_layout()\n",
    "plt.savefig('confusion_matrix.png', dpi=150, bbox_inches='tight')\n",
    "plt.show()\n",
    "\n",
    "# Classification Report\n",
    "print(\"\\nClassification Report:\")\n",
    "print(\"=\" * 60)\n",
    "print(classification_report(true_classes, predicted_classes, target_names=class_labels))"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 14. Menyimpan Model dalam Format SavedModel"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Direktori untuk SavedModel\n",
    "SAVED_MODEL_DIR = 'saved_model'\n",
    "\n",
    "# Simpan model\n",
    "model.save(SAVED_MODEL_DIR)\n",
    "\n",
    "print(f\"✅ Model berhasil disimpan dalam format SavedModel di: {SAVED_MODEL_DIR}\")\n",
    "print(\"\\nIsi direktori SavedModel:\")\n",
    "for root, dirs, files in os.walk(SAVED_MODEL_DIR):\n",
    "    level = root.replace(SAVED_MODEL_DIR, '').count(os.sep)\n",
    "    indent = ' ' * 2 * level\n",
    "    print(f'{indent}{os.path.basename(root)}/')\n",
    "    subindent = ' ' * 2 * (level + 1)\n",
    "    for file in files:\n",
    "        print(f'{subindent}{file}')"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 15. Konversi dan Simpan Model ke Format TF-Lite"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Direktori untuk TF-Lite\n",
    "TFLITE_DIR = 'tflite'\n",
    "os.makedirs(TFLITE_DIR, exist_ok=True)\n",
    "\n",
    "# Konversi ke TF-Lite\n",
    "converter = tf.lite.TFLiteConverter.from_saved_model(SAVED_MODEL_DIR)\n",
    "\n",
    "# Optimisasi (opsional - untuk ukuran lebih kecil)\n",
    "converter.optimizations = [tf.lite.Optimize.DEFAULT]\n",
    "\n",
    "# Konversi\n",
    "tflite_model = converter.convert()\n",
    "\n",
    "# Simpan model TF-Lite\n",
    "tflite_model_path = os.path.join(TFLITE_DIR, 'model.tflite')\n",
    "with open(tflite_model_path, 'wb') as f:\n",
    "    f.write(tflite_model)\n",
    "\n",
    "print(f\"✅ Model TF-Lite berhasil disimpan di: {tflite_model_path}\")\n",
    "print(f\"   Ukuran file: {os.path.getsize(tflite_model_path) / (1024*1024):.2f} MB\")\n",
    "\n",
    "# Simpan label.txt\n",
    "label_path = os.path.join(TFLITE_DIR, 'label.txt')\n",
    "with open(label_path, 'w') as f:\n",
    "    for label in labels:\n",
    "        f.write(f\"{label}\\n\")\n",
    "\n",
    "print(f\"✅ Label berhasil disimpan di: {label_path}\")\n",
    "\n",
    "# Tampilkan isi label.txt\n",
    "print(\"\\nIsi label.txt:\")\n",
    "with open(label_path, 'r') as f:\n",
    "    print(f.read())"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 16. Konversi dan Simpan Model ke Format TFJS"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Install tensorflowjs jika belum ada\n",
    "!pip install tensorflowjs\n",
    "\n",
    "import subprocess\n",
    "\n",
    "# Direktori untuk TFJS\n",
    "TFJS_DIR = 'tfjs_model'\n",
    "os.makedirs(TFJS_DIR, exist_ok=True)\n",
    "\n",
    "# Konversi menggunakan command line tensorflowjs_converter\n",
    "try:\n",
    "    subprocess.run([\n",
    "        'tensorflowjs_converter',\n",
    "        '--input_format=tf_saved_model',\n",
    "        '--output_format=tfjs_graph_model',\n",
    "        SAVED_MODEL_DIR,\n",
    "        TFJS_DIR\n",
    "    ], check=True)\n",
    "    \n",
    "    print(f\"✅ Model TFJS berhasil disimpan di: {TFJS_DIR}\")\n",
    "    \n",
    "    # List isi direktori TFJS\n",
    "    print(\"\\nIsi direktori TFJS:\")\n",
    "    for file in os.listdir(TFJS_DIR):\n",
    "        file_path = os.path.join(TFJS_DIR, file)\n",
    "        size = os.path.getsize(file_path) / 1024  # KB\n",
    "        print(f\"  {file}: {size:.2f} KB\")\n",
    "        \n",
    "except Exception as e:\n",
    "    print(f\"Error saat konversi TFJS: {e}\")\n",
    "    print(\"\\nCoba install tensorflowjs dengan: pip install tensorflowjs\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 17. Inference Menggunakan SavedModel"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "print(\"=\" * 60)\n",
    "print(\"INFERENCE MENGGUNAKAN SAVEDMODEL\")\n",
    "print(\"=\" * 60)\n",
    "\n",
    "# Load SavedModel\n",
    "loaded_model = tf.keras.models.load_model(SAVED_MODEL_DIR)\n",
    "\n",
    "# Fungsi untuk preprocessing gambar\n",
    "def preprocess_image(image_path, target_size=(150, 150)):\n",
    "    \"\"\"Preprocess gambar untuk inference\"\"\"\n",
    "    img = tf.keras.preprocessing.image.load_img(image_path, target_size=target_size)\n",
    "    img_array = tf.keras.preprocessing.image.img_to_array(img)\n",
    "    img_array = img_array / 255.0  # Normalisasi\n",
    "    img_array = np.expand_dims(img_array, axis=0)  # Tambah batch dimension\n",
    "    return img_array\n",
    "\n",
    "# Ambil sample gambar dari test set\n",
    "test_images = []\n",
    "for cls in os.listdir(TEST_DIR):\n",
    "    class_dir = os.path.join(TEST_DIR, cls)\n",
    "    if os.path.isdir(class_dir):\n",
    "        images = os.listdir(class_dir)\n",
    "        if images:\n",
    "            test_images.append(os.path.join(class_dir, images[0]))\n",
    "\n",
    "# Inference\n",
    "print(\"\\nHasil Inference SavedModel:\")\n",
    "print(\"-\" * 60)\n",
    "\n",
    "for img_path in test_images[:5]:  # Ambil 5 sample\n",
    "    if os.path.exists(img_path):\n",
    "        # Preprocess\n",
    "        img_array = preprocess_image(img_path)\n",
    "        \n",
    "        # Predict\n",
    "        predictions = loaded_model.predict(img_array, verbose=0)\n",
    "        predicted_class = labels[np.argmax(predictions[0])]\n",
    "        confidence = np.max(predictions[0]) * 100\n",
    "        \n",
    "        print(f\"Gambar: {os.path.basename(img_path)}\")\n",
    "        print(f\"  Prediksi: {predicted_class}\")\n",
    "        print(f\"  Confidence: {confidence:.2f}%\")\n",
    "        print()"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 18. Inference Menggunakan TF-Lite"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "print(\"=\" * 60)\n",
    "print(\"INFERENCE MENGGUNAKAN TF-LITE\")\n",
    "print(\"=\" * 60)\n",
    "\n",
    "# Load TF-Lite model\n",
    "interpreter = tf.lite.Interpreter(model_path=tflite_model_path)\n",
    "interpreter.allocate_tensors()\n",
    "\n",
    "# Get input dan output details\n",
    "input_details = interpreter.get_input_details()\n",
    "output_details = interpreter.get_output_details()\n",
    "\n",
    "print(\"\\nInput Details:\")\n",
    "print(f\"  Shape: {input_details[0]['shape']}\")\n",
    "print(f\"  Dtype: {input_details[0]['dtype']}\")\n",
    "\n",
    "print(\"\\nOutput Details:\")\n",
    "print(f\"  Shape: {output_details[0]['shape']}\")\n",
    "print(f\"  Dtype: {output_details[0]['dtype']}\")\n",
    "\n",
    "# Fungsi inference TF-Lite\n",
    "def tflite_inference(interpreter, image_path, target_size=(150, 150)):\n",
    "    \"\"\"Inference menggunakan TF-Lite\"\"\"\n",
    "    # Preprocess\n",
    "    img = tf.keras.preprocessing.image.load_img(image_path, target_size=target_size)\n",
    "    img_array = tf.keras.preprocessing.image.img_to_array(img)\n",
    "    img_array = img_array / 255.0\n",
    "    img_array = np.expand_dims(img_array, axis=0).astype(np.float32)\n",
    "    \n",
    "    # Set input\n",
    "    interpreter.set_tensor(input_details[0]['index'], img_array)\n",
    "    \n",
    "    # Run inference\n",
    "    interpreter.invoke()\n",
    "    \n",
    "    # Get output\n",
    "    output = interpreter.get_tensor(output_details[0]['index'])\n",
    "    return output\n",
    "\n",
    "# Inference\n",
    "print(\"\\nHasil Inference TF-Lite:\")\n",
    "print(\"-\" * 60)\n",
    "\n",
    "for img_path in test_images[:5]:\n",
    "    if os.path.exists(img_path):\n",
    "        # Inference\n",
    "        predictions = tflite_inference(interpreter, img_path)\n",
    "        predicted_class = labels[np.argmax(predictions[0])]\n",
    "        confidence = np.max(predictions[0]) * 100\n",
    "        \n",
    "        print(f\"Gambar: {os.path.basename(img_path)}\")\n",
    "        print(f\"  Prediksi: {predicted_class}\")\n",
    "        print(f\"  Confidence: {confidence:.2f}%\")\n",
    "        print()"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 19. Visualisasi Hasil Inference"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def visualize_predictions(model, test_dir, labels, num_images=9):\n",
    "    \"\"\"Visualisasi hasil prediksi\"\"\"\n",
    "    plt.figure(figsize=(15, 15))\n",
    "    \n",
    "    # Kumpulkan gambar dari semua kelas\n",
    "    all_images = []\n",
    "    for cls in os.listdir(test_dir):\n",
    "        class_dir = os.path.join(test_dir, cls)\n",
    "        if os.path.isdir(class_dir):\n",
    "            for img_name in os.listdir(class_dir)[:3]:\n",
    "                all_images.append((os.path.join(class_dir, img_name), cls))\n",
    "    \n",
    "    # Ambil sample\n",
    "    sample_images = all_images[:num_images]\n",
    "    \n",
    "    for i, (img_path, true_label) in enumerate(sample_images):\n",
    "        plt.subplot(3, 3, i + 1)\n",
    "        \n",
    "        # Load dan tampilkan gambar\n",
    "        img = tf.keras.preprocessing.image.load_img(img_path, target_size=(150, 150))\n",
    "        plt.imshow(img)\n",
    "        \n",
    "        # Prediksi\n",
    "        img_array = preprocess_image(img_path)\n",
    "        predictions = model.predict(img_array, verbose=0)\n",
    "        predicted_class = labels[np.argmax(predictions[0])]\n",
    "        confidence = np.max(predictions[0]) * 100\n",
    "        \n",
    "        # Set warna title berdasarkan benar/salah\n",
    "        color = 'green' if predicted_class == true_label else 'red'\n",
    "        plt.title(f\"True: {true_label}\\nPred: {predicted_class} ({confidence:.1f}%)\", \n",
    "                  color=color, fontsize=10)\n",
    "        plt.axis('off')\n",
    "    \n",
    "    plt.suptitle('Hasil Prediksi Model', fontsize=16)\n",
    "    plt.tight_layout()\n",
    "    plt.savefig('prediction_results.png', dpi=150, bbox_inches='tight')\n",
    "    plt.show()\n",
    "\n",
    "visualize_predictions(loaded_model, TEST_DIR, labels)"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 20. Membuat File ZIP untuk Submission"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Buat struktur submission\n",
    "submission_dir = 'submission'\n",
    "os.makedirs(submission_dir, exist_ok=True)\n",
    "\n",
    "# Copy semua file yang diperlukan\n",
    "import shutil\n",
    "\n",
    "# Copy saved_model\n",
    "if os.path.exists(SAVED_MODEL_DIR):\n",
    "    shutil.copytree(SAVED_MODEL_DIR, os.path.join(submission_dir, 'saved_model'), dirs_exist_ok=True)\n",
    "\n",
    "# Copy tflite\n",
    "if os.path.exists(TFLITE_DIR):\n",
    "    shutil.copytree(TFLITE_DIR, os.path.join(submission_dir, 'tflite'), dirs_exist_ok=True)\n",
    "\n",
    "# Copy tfjs_model\n",
    "if os.path.exists(TFJS_DIR):\n",
    "    shutil.copytree(TFJS_DIR, os.path.join(submission_dir, 'tfjs_model'), dirs_exist_ok=True)\n",
    "\n",
    "print(\"✅ Semua model berhasil dicopy ke direktori submission\")\n",
    "print(\"\\nStruktur direktori submission:\")\n",
    "for root, dirs, files in os.walk(submission_dir):\n",
    "    level = root.replace(submission_dir, '').count(os.sep)\n",
    "    indent = ' ' * 2 * level\n",
    "    print(f'{indent}{os.path.basename(root)}/')\n",
    "    subindent = ' ' * 2 * (level + 1)\n",
    "    for file in files:\n",
    "        print(f'{subindent}{file}')"
   ]
  },
